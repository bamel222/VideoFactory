# ============================================================
#  Video Factory — variables d'environnement de PRODUCTION
#  Copier ce fichier en `.env` (dans infra/) et remplir les valeurs.
#  NE JAMAIS committer le `.env` réel.
# ============================================================

# --- PostgreSQL (interne au Docker Compose) ---
POSTGRES_USER=vf
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
POSTGRES_DB=videofactory

# --- Sécurité (OBLIGATOIRE : générer des valeurs fortes) ---
# Générer avec :  openssl rand -base64 32
ENCRYPTION_KEY=CHANGEZ_MOI_base64_32_octets
JWT_SECRET=CHANGEZ_MOI_autre_secret_fort

# --- Providers IA (optionnels au début ; nécessaires pour de VRAIES vidéos) ---
OPENAI_API_KEY=
DEEPL_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# --- Notifications email (optionnel ; laisser vide = désactivé) ---
# EMAIL_PROVIDER: resend | sendgrid | smtp | (vide)
EMAIL_PROVIDER=
EMAIL_FROM=Video Factory <no-reply@videofactory.ai>
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- URL publique de l'app (pour les liens dans les emails) ---
# Remplacer par http://<IP_DE_VOTRE_INSTANCE> une fois déployé
APP_BASE_URL=http://localhost:3000

# --- Stockage S3-compatible (OVHCloud) ---
# Ces valeurs se configurent aussi DANS l'application (page Stockage).
# ALLOW_PRIVATE_STORAGE_ENDPOINTS=true uniquement si vous utilisez un
# endpoint interne/privé (ex. MinIO local). Pour OVHCloud public, laisser false.
ALLOW_PRIVATE_STORAGE_ENDPOINTS=false
